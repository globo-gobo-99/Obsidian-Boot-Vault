# Inventory only: bootstrap-vault.py reads process variables, not this file.
# Replace placeholders in Codex Personal vault or the chosen task environment.
OB_SK_OWNER_EMAIL=bot-owner@example.invalid
OBSIDIAN_SYNC_EMAIL=bot-owner@example.invalid
OBSIDIAN_VAULT_ID=REPLACE_WITH_EXISTING_32_HEX_VAULT_ID
OBSIDIAN_VAULT_PATH=/workspace/vaults/DevPod-Vault
OBSIDIAN_STATE_HOME=/workspace/.dot-box-config
OBSIDIAN_DEVICE_PREFIX=codex-cloud-box
# Optional explicit name; otherwise preserve or generate a unique identity.
OBSIDIAN_DEVICE_NAME=
# Direct personal variables: supply real values outside Git.
OBSIDIAN_AUTH_TOKEN=
OBSIDIAN_E2EE_PASSWORD=
# Optional account-login fallback; separate from vault encryption password.
OBSIDIAN_SYNC_PASSWORD=
